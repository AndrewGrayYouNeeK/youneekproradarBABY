{
  "name": "Article",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Article headline"
    },
    "slug": {
      "type": "string",
      "description": "URL-friendly identifier"
    },
    "description": {
      "type": "string",
      "description": "Short summary of the article (1-2 sentences) used for SEO and previews"
    },
    "body": {
      "type": "string",
      "description": "Full article content in Markdown"
    },
    "category": {
      "type": "string",
      "enum": [
        "safety",
        "science",
        "guide",
        "news"
      ],
      "default": "guide",
      "description": "Topic category"
    },
    "published_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the article was published"
    },
    "is_public": {
      "type": "boolean",
      "default": true,
      "description": "Whether the article is visible to the public"
    }
  },
  "required": [
    "title",
    "description"
  ]
}